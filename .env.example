# Docker Compose lee este archivo cuando lo copias a .env.
# manage.py usa variables de entorno del sistema; no carga .env automáticamente.
DEBUG=0
DEMO_MODE=1
REFRENDO_YEAR=2026
PUBLIC_HOST=refrendo.example.org
PUBLIC_BASE_URL=https://refrendo.example.org
ALLOWED_HOSTS=refrendo.example.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://refrendo.example.org
SECRET_KEY=
DOCUMENT_SIGNING_KEY=
AUDIT_KEY=
POSTGRES_PASSWORD=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=1
